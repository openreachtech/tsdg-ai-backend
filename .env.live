## DATABASE

DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_DIALECT=
DATABASE_HOST=
DATABASE_PORT=

## AUTH
# Access-token lifetime is a fixed 15-minute module constant (not env-driven); only the
# refresh-token lifetime and the cookie attributes are configurable here.
# Secure cookies require TLS — over plain HTTP the browser drops them.

AUTH_REFRESH_TOKEN_TTL_DAYS=
AUTH_COOKIE_SECURE=
AUTH_COOKIE_SAME_SITE=
AUTH_COOKIE_PATH=
AUTH_COOKIE_DOMAIN=

## API CLIENT
#
# The key every client secret is encrypted under at rest. A client secret has to be
# decrypted to verify a signature, so this is symmetric encryption rather than a one-way
# hash — the plaintext must come back.
#
# Losing this value makes every stored client secret unreadable, and the clients that hold
# them cannot be told apart from forgeries. It is not derivable from anything else here.
#
# The development file also carries the client secrets in the clear, so that a seeder and a
# test can share one value. Nothing of that kind belongs here: on a live machine a secret
# exists encrypted in the row and nowhere else.

API_CLIENT_SECRET_ENCRYPTION_KEY=

## QUEUE
#
# The Redis the API server enqueues into and the job daemon consumes from. Both processes
# must point at one instance for a queue to work at all.
#
# The host and the port may not be left blank: an empty declaration is still a declaration,
# and `Number('')` is 0. An empty password means "send no AUTH", which is a decision rather
# than an omission -- state it deliberately.

REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# Whether the connection to that Redis is encrypted. A deployment pointing at a Redis anywhere
# but this machine SHOULD set this to `true`: without it the connection, and the AUTH carrying
# the password above, cross the network in cleartext. Only the literal `true` turns it on.
REDIS_TLS=
