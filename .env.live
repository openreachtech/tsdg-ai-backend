## DATABASE

DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_DIALECT=
DATABASE_HOST=
DATABASE_PORT=

## AUTH
# Access-token lifetime is a fixed 15-minute module constant (not env-driven); only the
# refresh-token lifetime and the cookie attributes are configurable here.
# Secure cookies require TLS — over plain HTTP the browser drops them.

AUTH_REFRESH_TOKEN_TTL_DAYS=
AUTH_COOKIE_SECURE=
AUTH_COOKIE_SAME_SITE=
AUTH_COOKIE_PATH=
AUTH_COOKIE_DOMAIN=

## API CLIENT
#
# The key every client secret is encrypted under at rest. A client secret has to be
# decrypted to verify a signature, so this is symmetric encryption rather than a one-way
# hash — the plaintext must come back.
#
# Losing this value makes every stored client secret unreadable, and the clients that hold
# them cannot be told apart from forgeries. It is not derivable from anything else here.
#
# The development file also carries the client secrets in the clear, so that a seeder and a
# test can share one value. Nothing of that kind belongs here: on a live machine a secret
# exists encrypted in the row and nowhere else.

API_CLIENT_SECRET_ENCRYPTION_KEY=

## QUEUE
#
# The Redis the API server enqueues into and the job daemon consumes from. Both processes
# must point at one instance for a queue to work at all.
#
# The host and the port may not be left blank: an empty declaration is still a declaration,
# and `Number('')` is 0. An empty password means "send no AUTH", which is a decision rather
# than an omission -- state it deliberately.

REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# Whether the connection to that Redis is encrypted. A deployment pointing at a Redis anywhere
# but this machine SHOULD set this to `true`: without it the connection, and the AUTH carrying
# the password above, cross the network in cleartext. Only the literal `true` turns it on.
REDIS_TLS=

## MEDIA FETCH
#
# The hosts this service may fetch a media file from. A URL on any other host is refused and
# nothing is fetched.
#
# Declared empty on purpose: a deployment states the client's own storage hosts, and until it
# does every URL is refused. An empty allow-list is the safe direction, so leaving this blank
# fetches nothing rather than fetching anything.
#
# Bare hostnames, separated by commas: no scheme, no port, no path.

MEDIA_FETCH_ALLOWED_HOSTS=

## GEMINI
#
# The Gemini API key, and it is empty on purpose. This repository is public and this file is
# tracked, so a key written here would be a published key. A default installation answers on the
# stub and reads nothing here; the key is read only once a request has named the Gemini model by
# name, and an empty value makes such a request refuse before it calls rather than call
# unauthenticated. Supply it from the environment of whoever runs the process.

GEMINI_API_KEY=


## VERTEX AI
#
# The preferred way to reach Gemini: the process calls as its own Google Cloud identity, so there
# is no key to store, to rotate, or to leak. Set both or neither - one without the other cannot
# address anything, and a half-finished configuration falls back to the key rather than reporting
# itself. The location must be a REGION: the SDK addresses
# https://<location>-aiplatform.googleapis.com, so a model served only globally is unreachable.
#
# Empty here on purpose. A default installation answers on the stub and reads neither.

VERTEX_AI_PROJECT_ID=
VERTEX_AI_LOCATION=

## DATABASE TRANSPORT
#
# How the driver reaches the database, where the address itself comes from the environment.
#
# DATABASE_HOST beginning with "/" is a unix socket - Cloud SQL on Cloud Run mounts one at
# /cloudsql/<connection name> - and it is handed to the driver as a socket path rather than as a
# host. Anything else is a host.
#
# DATABASE_SSL turns transport encryption on, and nothing else does. It is read as `true`, `false`
# or unset and refuses anything else: a misspelling read as `false` would leave a deployment
# believing it asked for an encrypted connection when it did not, and the difference is invisible
# from outside. It must not be `true` over a socket - a socket never reaches a network, so there is
# no transport to protect, and declaring both is refused rather than dropped quietly.
#
# DATABASE_SSL_CA is the PEM of the authority to verify the server against. Unset means the system
# trust store, which is right for a managed database with a publicly-signed certificate and wrong
# for one signed by a per-instance authority. Certificate verification is always on and no key can
# turn it off.

DATABASE_SSL=
DATABASE_SSL_CA=
