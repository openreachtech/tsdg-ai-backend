## DATABASE
#
# These keys feed the `production` entry of sequelize/config.cjs. The `development`
# entry is fixed to SQLite in that file, so a local `npm run db:refresh` does not read
# them — they are filled to match docker-compose.development.yml so that the two never
# disagree once an environment does read them.

DATABASE_NAME=development
DATABASE_USERNAME=user
DATABASE_PASSWORD=password
DATABASE_DIALECT=mariadb
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306

## AUTH
# Access-token lifetime is a fixed 15-minute module constant (not env-driven); only the
# refresh-token lifetime and the cookie attributes are configurable here.
#
# This service authenticates machines by signature and issues no cookie, so nothing it
# runs reads these. They are filled rather than left empty because an empty value is
# read as a decision by the boilerplate's GraphQL engine: AUTH_COOKIE_SECURE resolves
# to true when unset.

AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_PATH=/
AUTH_COOKIE_DOMAIN=localhost

## DOCKER
#
# Empty on purpose: the manual-verification table declares MariaDB and Redis, and both
# run without a profile. A profile is turned on here, never by editing the compose file.

COMPOSE_PROFILES=

## API CLIENT
#
# The key every client secret is encrypted under at rest. A client secret has to be
# decrypted to verify a signature, so this is symmetric encryption rather than a one-way
# hash — the plaintext must come back.
#
# The development client's own secret is kept in the clear beside it, because two things
# need the same value: the seeder encrypts it under the key above, and the tests sign a
# request with it. A development-only value for a local database.

API_CLIENT_SECRET_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
DEVELOPMENT_API_CLIENT_SECRET=development-client-secret-for-signing-requests

# One plaintext per development client row, each distinct. A request resolved to the wrong
# client then fails to verify instead of passing unnoticed, and a test can sign as any of
# the three by reading the value it needs.

DEVELOPMENT_ROTATING_API_CLIENT_SECRET=development-rotating-client-current-secret
DEVELOPMENT_ROTATING_API_CLIENT_PREVIOUS_SECRET=development-rotating-client-previous-secret
DEVELOPMENT_INACTIVE_API_CLIENT_SECRET=development-inactive-client-secret

## QUEUE
#
# The Redis the API server enqueues into and the job daemon consumes from. They are two
# separate processes and a queue only works while both point at one instance, so the
# address is declared once here and read through app/globals/_.js.
#
# The values match the `redis` service of docker-compose.development.yml exactly. An empty
# password is correct -- that Redis runs without `requirepass`, and an empty value is read
# as "send no AUTH". The host and the port are a different matter: an empty declaration is
# still a declaration, and `Number('')` is 0, so neither may be left blank.

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Whether the connection to that Redis is encrypted. Only the literal `true` turns it on, and
# when it is on the certificate is verified -- there is deliberately no key for turning the
# verification off, because a TLS connection authenticating nobody reads in a log exactly like
# one that does. Loopback against the compose service wants none of it.
REDIS_TLS=false

## MEDIA FETCH
#
# The hosts this service may fetch a media file from. A URL on any other host is refused and
# nothing is fetched, which is the first acceptance criterion of the media-fetch feature.
#
# The spec defines the allow-list and never says where it lives (see Q91 in the hora record).
# It is an environment key because development and live fetch from different storage, so the
# value is a deployment fact rather than a constant -- and adding a host is then a deployment
# change rather than a migration.
#
# Bare hostnames, separated by commas: no scheme, no port, no path. An undeclared or empty
# value builds an empty allow-list, which refuses every URL -- the failure direction is closed
# rather than open, deliberately.
#
# These two are `.invalid` (RFC 2606) like the callback hosts above, so a test that slipped
# past its stub and reached the network fails instead of reaching somebody.

MEDIA_FETCH_ALLOWED_HOSTS=files.client.development.invalid,storage.client.development.invalid
